{
    "name": "qubus/dbal",
    "type": "library",
    "description": "Database abstraction layer.",
    "keywords": ["database","querybuilder","dbal","database abstraction"],
    "license": "MIT",
    "authors": [
        {
            "name": "Joshua Parker",
            "email": "joshua@joshuaparker.dev"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "psr/cache": "^3",
        "qubus/exception": "^4",
        "qubus/support": "^4",
        "qubus/valueobjects": "^4"
    },
    "require-dev": {
        "qubus/qubus-coding-standard": "^2"
    },
    "autoload": {
        "psr-4": {
            "Qubus\\Dbal\\": ""
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --colors=always",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
